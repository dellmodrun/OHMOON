dth="78" height="78" draggable="false"/></div><a class="xlink" href="https://jup.ag/tokens/AhBidGAgv6QbKSWfrSCegGrzFLcBx4E5FNYTKHNQQj6C" target="_blank" rel="noreferrer" aria-label="$LAUNCH"><span class="sideicon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" class="ico" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"></path></svg></span><span>$LAUNCH</span></a></aside><div class="body"><header class="tnav"><a class="tn-brand" aria-label="launch" href="/"><img src="/brand/mark-64.png" width="30" height="30" alt="launch" class="mark" draggable="false"/><span class="wordmark">launch</span></a><nav class="tn-links" aria-label="Site"><a class="" href="/">board</a><a class="" href="/live">live launches</a><a class="" href="/calls">calls</a><a class="" href="/burns">burns</a><a class="on" href="/launch">create coin</a><a class="" href="/how">how it works</a></nav><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><div class="search"></div><!--/$--><span class="wchip-ph wchip-tnav" aria-hidden="true"></span><a class="btn btn-sm tn-create" href="/launch"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" class="ico" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg> create coin</a></header><header class="top"><a class="brand brand-m" aria-label="launch" href="/"><img src="/brand/mark-180.png" width="34" height="34" alt="launch" class="mark" draggable="false"/><span class="wordmark">launch</span></a><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><div class="search"></div><!--/$--><div class="live" aria-live="polite"></div><a class="btn btn-sm top-create" href="/launch"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" class