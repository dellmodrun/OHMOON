9:["$","section",null,{"className":"rule","children":[["$","span",null,{"className":"rule-n mono","children":"05"}],["$","div",null,{"className":"rule-copy","children":[["$","h2",null,{"children":"every trade burns twice."}],["$","p",null,{"children":"Every trade on every coin pays the platform a 3% fee (Raydium takes its own 0.25% on top). Every few minutes the master wallet claims it and splits it three ways: 1% buys the coin that was traded back and burns it, 1% buys $LAUNCH and burns it, and 1% stays in the treasury. Each coin's share comes from its own trades, so the ledger shows exactly what it earned and what it burned. The buybacks go through Jupiter on the open market, on the curve or the Raydium pool after graduation, and every token bought is burned. Launches never spend buyback money."}]]}],["$","div",null,{"className":"rule-demo","children":[["$","div",null,{"className":"pair-flow","children":[["$","span",null,{"className":"pf-chip","children":"1% $COIN"}],["$","span",null,{"className":"pf-chip","children":"1% $LAUNCH"}],["$","span",null,{"className":"pf-chip","children":"1% treasury"}]]}],["$","div",null,{"className":"pair-flow","children":[["$","span",null,{"className":"pf-chip","children":"3% fee"}],["$","svg",null,{"viewBox":"0 0 24 24","width":18,"height":18,"fill":"none","stroke":"currentColor","strokeWidth":2.1,"strokeLinecap":"round","strokeLinejoin":"round","className":"ico","aria-hidden":true,"children":[null,"$0:data:0:rsc:props:children:0:props:children:2:props:children:2:props:children:0:props:children:1:props:children:1"]}],["$","span",null,{"className":"pf-chip pf-vault","children":[["$","img",null,{"src":"/brand/mark-64.png","width":16,"height":16,"alt":"launch","className":"mark","draggable":false}]," master"]}],["$","svg",null,{"viewBox":"0 0 24 24","width":18,"height":18,"fill":"none","stroke":"currentColor","strokeWidth":2.1,"strokeLinecap":"round","strokeLinejoin":"round","className":"ico","aria-hidden":true,"children":[null,"$0:dat