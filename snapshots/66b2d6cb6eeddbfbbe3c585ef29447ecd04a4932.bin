8:["$","section",null,{"className":"rule","children":[["$","span",null,{"className":"rule-n mono","children":"04"}],["$","div",null,{"className":"rule-copy","children":[["$","h2",null,{"children":"no block 0."}],["$","p",null,{"children":"Snipers win the first block by riding in the creator's bundle or by seeing the create before it lands. Here the create goes out as a private bundle with a tip, never through the public pool, and the mint address is never published early. Nobody can be in the block it is created in. After that it trades like any coin on its curve: no same-block edge, no promise of sniper-proof."}]]}],["$","div",null,{"className":"rule-demo","children":["$","div",null,{"className":"blocks","aria-label":"block 0 holds only the create","children":[["$","div","0",{"className":"blk blk-0","style":{"--k":0},"children":[["$","span",null,{"className":"mono blk-n","children":["block ",0]}],["$","span",null,{"className":"blk-tx blk-create","children":[["$","img",null,{"src":"/brand/mark-64.png","width":16,"height":16,"alt":"launch","className":"mark","draggable":false}]," create"]}]]}],["$","div","1",{"className":"blk","style":{"--k":1},"children":[["$","span",null,{"className":"mono blk-n","children":["block ",1]}],[["$","span","0",{"className":"blk-tx","style":{"--j":0}}],["$","span","1",{"className":"blk-tx","style":{"--j":1}}]]]}],["$","div","2",{"className":"blk","style":{"--k":2},"children":[["$","span",null,{"className":"mono blk-n","children":["block ",2]}],[["$","span","0",{"className":"blk-tx","style":{"--j":0}}],["$","span","1",{"className":"blk-tx","style":{"--j":1}}],["$","span","2",{"className":"blk-tx","style":{"--j":2}}]]]}],["$","div","3",{"className":"blk","style":{"--k":3},"children":[["$","span",null,{"className":"mono blk-n","children":["block ",3]}],[["$","span","0",{"className":"blk-tx","style":{"--j":0}}],["$","span","1",{"className":"blk-tx","style":{"--j":1}}],["$","span","2",{"className":"blk-tx","style":{"--j":2}}],["$","span","3",