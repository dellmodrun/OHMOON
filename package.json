{
  "name": "onemod",
  "version": "0.1.0",
  "private": true,
  "description": "A modular genesis layer for tokens launching into Pump.fun.",
  "scripts": {
    "start": "node server.cjs",
    "build:client": "esbuild src/pump-client.js --bundle --minify --inject:src/shims.js --define:global=globalThis --platform=browser --format=iife --target=es2020 --outfile=pump-client.bundle.js",
    "prepare:pages": "node prepare-pages.cjs"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.3.1",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "process": "0.11.10"
  },
  "devDependencies": {
    "esbuild": "0.25.11"
  }
}
